{
  "name": "local_ai_workstation",
  "version": "1.0.1-dev",
  "description": "This is a Local AI workstation Project with capability and access to the common tools and tool-ing that the best LLM's, the frontier models, also have access to. It should be able to assist in common inquiries as well as dedicated tasks.",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "vite": "vite --config vite.config.mjs",
    "build": "vite build --config vite.config.mjs && npm run build:mobile",
    "build:mobile": "vite build --config mobile-companion/web/vite.config.mjs",
    "build:android": "powershell -NoProfile -ExecutionPolicy Bypass -File mobile-companion/android/tools/build-apk.ps1",
    "test:android": "powershell -NoProfile -ExecutionPolicy Bypass -File mobile-companion/android/tools/build-apk.ps1 -ChecksOnly",
    "qa:android": "electron mobile-companion/android/tools/qa-native-adapter.cjs",
    "vite:mobile": "vite --config mobile-companion/web/vite.config.mjs",
    "test": "vitest run --config vitest.config.mjs",
    "test:watch": "vitest --config vitest.config.mjs",
    "test:backend": "venv\\Scripts\\python.exe -m pytest",
    "test:media": "node scripts/test-media-manager.cjs",
    "verify": "npm run test && npm run test:backend && npm run test:media && npm run build",
    "test:mobile": "vitest run --config vitest.config.mjs mobile-companion/tests/frontend",
    "test:mobile:backend": "venv\\Scripts\\python.exe -m pytest mobile-companion/tests/backend",
    "qa:mobile": "electron mobile-companion/scripts/qa-mobile-companion.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.10.1",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@spotify/basic-pitch": "1.0.1",
    "@tensorflow/tfjs": "3.21.0",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-highlight": "3.32.2",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-subscript": "3.32.2",
    "@tiptap/extension-superscript": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extension-text-align": "3.32.2",
    "@tiptap/extension-text-style": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "@tonejs/midi": "2.0.28",
    "linkedom": "0.18.14",
    "manifold-3d": "3.5.4",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.186.1"
  },
  "overrides": {
    "@tensorflow/tfjs": {
      "argparse": "2.0.1"
    }
  }
}
